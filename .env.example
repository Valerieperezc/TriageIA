VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Debe ser la clave "anon" / "public" (Project Settings → API). Nunca uses aquí la "service_role" (secret): el navegador la rechaza.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Solo para scripts locales (p. ej. npm run seed:dataset -- --insert-supabase). No expongas en el front.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

